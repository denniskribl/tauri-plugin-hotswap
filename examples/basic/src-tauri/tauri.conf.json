{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "hotswap-example",
  "version": "0.1.0",
  "identifier": "com.example.hotswap",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Hotswap Example",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "hotswap": {
      "endpoint": "https://example.com/api/ota/{{current_sequence}}",
      "pubkey": "REPLACE_WITH_YOUR_PUBKEY"
    }
  }
}
